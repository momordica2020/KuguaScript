// ========================================
// 勇者的试炼 — 文字冒险RPG小游戏
// 展示苦瓜脚本语言的完整语法特性
// 自动战斗模式，无需输入即可运行
// ========================================

// ========== 角色定义（类/对象） ==========
勇者：
    名字：“勇者”。
    生命：100。
    攻击：15。
    金币：0。
    药水：3。

史莱姆：
    名字：“史莱姆”。
    生命：25。
    攻击：8。
    金币：5。

哥布林：
    名字：“哥布林”。
    生命：40。
    攻击：12。
    金币：10。

巨龙：
    名字：“巨龙”。
    生命：70。
    攻击：18。
    金币：30。

// ========== 辅助函数 ==========

显示勇者状态：输入“玩家”；
    说（“【勇者】 生命：” + 玩家之生命 + “ 攻击：” + 玩家之攻击 + “ 金币：” + 玩家之金币 + “ 药水：” + 玩家之药水）。

显示敌人状态：输入“敌人”；
    说（“【” + 敌人之名字 + “】 生命：” + 敌人之生命 + “ 攻击：” + 敌人之攻击）。

// ========== 智能决策函数 ==========
// 返回 1 表示攻击，2 表示使用药水
智能决策：输入“玩家”；
    如果（玩家之生命 小于 30 并且 玩家之药水 大于 0）：
        结果是2。
    否则：
        结果是1。

// ========== 战斗函数 ==========
// 返回正确表示胜利，错误表示失败
战斗：输入“玩家”、“敌人”；
    说（“”）。
    说（“====================”）。
    说（“遭遇” + 敌人之名字 + “！”）。
    说（“====================”）。
    显示勇者状态（玩家）。
    显示敌人状态（敌人）。

    循环 30 次（回合）：
        如果（玩家之生命 小于等于 0）：
            结束。
        如果（敌人之生命 小于等于 0）：
            结束。

        说（“”）。
        说（“—— 第” + 回合 + “回合 ——”）。

        决策：智能决策（玩家）。

        如果（决策 是 1）：
            敌人之生命：敌人之生命 - 玩家之攻击。
            说（“勇者攻击” + 敌人之名字 + “，造成” + 玩家之攻击 + “点伤害。”）。
            如果（敌人之生命 小于等于 0）：
                结束。

        如果（决策 是 2）：
            如果（玩家之药水 大于 0）：
                玩家之生命：玩家之生命 + 25。
                玩家之药水：玩家之药水 - 1。
                说（“使用药水，恢复25点生命。当前生命：” + 玩家之生命）。
            否则：
                说（“没有药水了！改为攻击。”）。
                敌人之生命：敌人之生命 - 玩家之攻击。
                说（“勇者攻击” + 敌人之名字 + “，造成” + 玩家之攻击 + “点伤害。”）。
                如果（敌人之生命 小于等于 0）：
                    结束。

        // 怪物反击
        如果（敌人之生命 大于 0）：
            玩家之生命：玩家之生命 - 敌人之攻击。
            说（敌人之名字 + “反击，造成” + 敌人之攻击 + “点伤害。”）。
            显示勇者状态（玩家）。

    说（“”）。
    如果（敌人之生命 小于等于 0）：
        玩家之金币：玩家之金币 + 敌人之金币。
        说（“胜利！击败” + 敌人之名字 + “，获得” + 敌人之金币 + “金币。”）。
        结果是正确。
    否则：
        如果（玩家之生命 小于等于 0）：
            说（“勇者被击败了...”）。
        结果是错误。

// ========== 游戏主流程 ==========

说（“================================”）。
说（“      勇者的试炼 - 文字冒险RPG      ”）。
说（“================================”）。
说（“”）。
说（“你是一名勇者，踏上讨伐巨龙的旅途。”）。
说（“击败所有怪物，赢得荣耀！”）。
说（“”）。

// 第一战：史莱姆
说（“【第一关】史莱姆出现了！”）。
战斗（勇者，史莱姆）。

如果（勇者之生命 小于等于 0）：
    说（“游戏结束。勇者倒下了。”）。
否则：
    显示勇者状态（勇者）。

    说（“”）。
    说（“【第二关】哥布林出现了！”）。
    战斗（勇者，哥布林）。

    如果（勇者之生命 小于等于 0）：
        说（“游戏结束。勇者倒下了。”）。
    否则：
        显示勇者状态（勇者）。

        说（“”）。
        说（“【最终关】巨龙出现了！”）。
        战斗（勇者，巨龙）。

        如果（勇者之生命 小于等于 0）：
            说（“游戏结束。勇者倒下了。”）。
        否则：
            说（“”）。
            说（“================================”）。
            说（“  恭喜通关！你是真正的勇者！  ”）。
            显示勇者状态（勇者）。
            说（“================================”）。
